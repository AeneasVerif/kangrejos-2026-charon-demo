#!/usr/bin/env bash
set -euo pipefail

is_kernel=false
previous=
for argument in "$@"; do
    if [[ "$previous" == "--crate-name" && "$argument" == "kernel" ]]; then
        is_kernel=true
        break
    fi
    previous=$argument
done

if [[ "$is_kernel" == false ]]; then
    exec "$CHARON_RUSTC" "$@"
fi

# Kbuild already selects an edition. Remove it so each Charon invocation can
# make its own choice.
rustc_args=()
while (($#)); do
    case "$1" in
        --edition)
            shift 2
            ;;
        --edition=*)
            shift
            ;;
        *)
            rustc_args+=("$1")
            shift
            ;;
    esac
done

"$CHARON_BIN" rustc \
    $CHARON_OPTIONS \
    --precise-drops \
    --format postcard \
    --sysroot default \
    --dest-file "$CHARON_OUTPUT_2021" \
    -- "${rustc_args[@]}" --edition=2021

export CHARON_EMIT_ARTIFACTS=1
exec "$CHARON_BIN" rustc \
    $CHARON_OPTIONS \
    --precise-drops \
    --format postcard \
    --sysroot default \
    --dest-file "$CHARON_OUTPUT_2024" \
    -- "${rustc_args[@]}" --edition=2024
